; Engine configuration file.
config_version=5

[application]

config/name="VectorSports"
config/description="Use your phone as a motion controller."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/size/mode=3

[gui]

theme/custom_font="res://fonts/Rounded-Medium.ttf"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
textures/default_filters/anisotropic_filtering_level=2
rendering_device/fallback_to_opengl3=true

[shader_globals]

crowd_excite={
"type": "float",
"value": 0.0
}
